    <!-- Prominent location disclosure, shown before the runtime permission request as
         required by the Google Play User Data policy. -->
    <string name="ssid_disclosure_title">Auto-fill your Wi-Fi network name?</string>
    <string name="ssid_disclosure_body"><![CDATA[
        This app can fill in the network name (SSID) field for you by reading which
        Wi-Fi network this phone is connected to.
        <br/><br/>
        Android treats the name of your Wi-Fi network as <b>location data</b>, so this
        app needs the <b>location permission</b> to read it. This app uses location
        access <b>only</b> to read your current Wi-Fi network name and place it in the
        network name field, so your WaveshareMon can join the same network. It never reads
        your GPS position, never tracks you, and never sends your location or network
